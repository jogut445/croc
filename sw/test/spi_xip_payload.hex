// XiP payload for test_xip.c
// Loaded with $readmemh into the flash byte-wide memory array.
// Byte address 0x000000 maps to OBI address SPI_XIP_BASE_ADDR (UserBaseAddr + 0x2000);
// the XiP controller subtracts the XiP base before issuing the flash address.
//
// int xip_add(int a, int b) at 0x20002000:
//   add  a0, a0, a1   -> 33 05 b5 00   (a0 = a0 + a1)
//   ret               -> 67 80 00 00
@000000
33 05 b5 00 67 80 00 00
